# Gmail SMTP via Google App Password (server-only — never use VITE_ prefix)
# 1) Enable 2-Step Verification on the Gmail account
# 2) Google Account → Security → App passwords → create one for "Mail"
# 3) Paste the 16-character password below (spaces optional)


GMAIL_USER=salmanhy123456@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where inquiries are delivered (can be same as GMAIL_USER)
CONTACT_TO_EMAIL=salmanhy123456@gmail.com

# Optional
CONTACT_OWNER_NAME=Muhammad Salman

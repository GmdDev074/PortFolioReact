# Resend — https://resend.com (server only, never prefix with VITE_)
RESEND_API_KEY=re_xxxxxxxx

# Where inquiries are delivered (your inbox)
# With onboarding@resend.dev this MUST be the same email as your Resend account login
CONTACT_TO_EMAIL=salmanhy123456@gmail.com

# From address shown on emails
# IMPORTANT:
# - onboarding@resend.dev can ONLY send to YOUR Resend account email (testing).
# - To email real visitors a thank-you, verify a domain in Resend, then use e.g.:
#   CONTACT_FROM_EMAIL=Muhammad Salman <hello@yourdomain.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional display name in thank-you email
CONTACT_OWNER_NAME=Muhammad Salman

# Optional: lock CORS to your live site (recommended in production)
# CONTACT_ALLOWED_ORIGIN=https://your-portfolio.vercel.app
